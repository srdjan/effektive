imports Users from "./users-service.eff"
import { User, UserId, UserMissing, StoreUnavailable } from "./users-service.eff"

const getUser = (id: UserId) =>
  match Users.find(id) {
    Some(user) => user,
    None => fail(UserMissing({ id }))
  }

const activate = (user: User) =>
  ({ ...user, active: true })

export const saveActive = (id: UserId): User => {
  const user = getUser(id)
  if (user.active) { user } else {
    const active = activate(user)
    Users.save(active)
    active
  }
}

type Label = string

export const activationLabel = (id: UserId): Label =>
  try {
    saveActive(id)
    "active"
  } catch {
    UserMissing(error) => "missing: " + error.id
  }
