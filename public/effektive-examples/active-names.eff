imports Users from "./users-service.eff"
import { Name, User, StoreUnavailable } from "./users-service.eff"

const activeNames = (users: User[]) =>
  users
    |> filter((user) => user.active)
    |> map((user) => user.name)

export const listActiveNames = (): Name[]
  fails StoreUnavailable =>
  Users.all() |> activeNames
