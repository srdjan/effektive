imports Orders from "./payment-services.eff"
imports Payments from "./payment-services.eff"
import { Order, OrderId, OrderNotFound } from "./payment-services.eff"

const findOrder = (id: OrderId) =>
  Orders.find(id) ?? fail(OrderNotFound({ id }))

const chargeOrder = (order: Order) => {
  retry(() => Payments.charge(order.totalCents), { times: 2 })
  order
}

const markPaid = (order: Order) =>
  ({ ...order, status: "paid" })

const saveOrder = (order: Order) => {
  Orders.save(order)
  order
}

export const pay = (id: OrderId): Order =>
  id
    |> findOrder
    |> chargeOrder
    |> markPaid
    |> saveOrder
